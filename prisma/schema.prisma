// W3Runn3rs — schema.prisma
// Stack: Next.js 14 App Router · Neon PostgreSQL · Prisma 7 · Better Auth
// Last updated: 2026-06

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  RUNNER
  CLUB_ADMIN
  ADMIN
}

enum DistanceUnit {
  KM
  MILES
}

enum DeviceProvider {
  GARMIN
  POLAR
  OURA
  WHOOP
  COROS
  SUUNTO
  STRAVA
  APPLE_HEALTH
  GOOGLE_FIT
}

enum PolarRegistrationStatus {
  PENDING    // token obtenido, falta POST /v3/users
  REGISTERED // usuario registrado en Polar, listo para leer datos
}

enum ClubType {
  RECREATIONAL
  COMPETITIVE
  TRAIL
  TRIATHLON
}

enum ActivityType {
  RUN
  TRAIL
  TREADMILL
  RACE
}

enum ActivitySource {
  MANUAL
  STRAVA
  GARMIN
  POLAR
  OURA
  WHOOP
  COROS
  SUUNTO
  APPLE_HEALTH
  GOOGLE_FIT
}

enum PRDistance {
  M400
  HALF_MILE
  K1
  MILE
  K2
  K5
  K10
  K15
  MILE10
  K20
  HALF_MARATHON
  K30
  MARATHON
  ULTRA
}

enum PRSource {
  AUTO   // calculado automáticamente desde una Activity
  MANUAL // ingresado por el usuario (Add PR)
}

enum PeriodType {
  WEEKLY
  MONTHLY
  YEARLY
  ALL_TIME
}

enum LeaderboardCategory {
  DISTANCE            // km totales del club
  PACE                // pace promedio del club
  ELEVATION           // elevación acumulada
  MARATHONS           // cantidad de maratones
  CONSISTENCY         // semanas sin parar
  DISTANCE_PER_MEMBER // km promedio por miembro activo
}

// ─────────────────────────────────────────────
// APP CONFIG — feature flags globales
// Un solo registro con id = "global"
// betaOpen = true abre el acceso a cualquier usuario registrado
// betaOpen = false solo dejan pasar emails en WaitlistEntry con betaAccess = true
// ─────────────────────────────────────────────

model AppConfig {
  id       String  @id @default("global")
  betaOpen Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("app_config")
}

// ─────────────────────────────────────────────
// TABLAS EXISTENTES — no se modifican
// ─────────────────────────────────────────────

model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  clubId     String?
  betaAccess Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Se marca cuando el waitlist entry se convierte en User
  convertedAt DateTime?

  club ClubRegistration? @relation(fields: [clubId], references: [id])
}

model ClubRegistration {
  id              String          @id @default(cuid())
  clubName        String
  city            String
  email           String          @unique
  runners         Int?
  logoUrl         String?
  enabled         Boolean         @default(false)
  instagram       String?
  twitter         String?
  tiktok          String?
  facebook        String?
  createdAt       DateTime        @default(now())
  waitlistEntries WaitlistEntry[]
}

model AmbassadorApplication {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  country    String
  instagram  String?
  twitter    String?
  tiktok     String?
  motivation String   @db.Text
  status     String   @default("pending") // pending | shortlisted | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────
// BETTER AUTH — user, session, account, verification
// Nombres y tipos exactos que requiere Better Auth
// con Prisma adapter. No modificar.
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?  // URL foto de perfil, viene de Google OAuth
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Perfil público
  username String? @unique // slug: @chaps
  bio      String?

  // Redes sociales
  twitterHandle     String?
  instagramHandle   String?
  facebookProfileUrl String?
  stravaProfileUrl  String?

  // Plataforma
  role          Role         @default(RUNNER)
  preferredUnit DistanceUnit @default(KM)
  locale        String       @default("en")
  timezone      String       @default("America/Mexico_City")
  lastActiveAt  DateTime?

  // Onboarding: null = perfil incompleto (gate lo manda a /onboarding).
  // Se setea al terminar el flujo de primer ingreso.
  onboardingCompletedAt DateTime?

  // Qué dispositivo tiene conectado HOY. Las credenciales reales
  // viven en su tabla específica (DeviceConnectionGarmin, DeviceConnectionPolar, etc.)
  // porque cada proveedor entrega datos distintos. Un usuario, un dispositivo activo.
  connectedProvider DeviceProvider? // null = sin dispositivo conectado

  // Relaciones Better Auth
  sessions Session[]
  accounts Account[]

  // Relaciones W3Runn3rs
  memberships      ClubMembership[]
  activities       Activity[]
  records          PersonalRecord[]
  snapshots        WeeklySnapshot[]
  garminConnection DeviceConnectionGarmin?
  polarConnection  DeviceConnectionPolar?
  stravaConnection DeviceConnectionStrava?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─────────────────────────────────────────────
// CLUBS
// ─────────────────────────────────────────────

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  city        String?
  country     String   @default("MX")
  clubType    ClubType @default(RECREATIONAL)

  instagram    String?
  twitter      String?
  tiktok       String?
  facebook     String?
  contactEmail String?

  initialMemberCount Int?
  memberCount        Int     @default(0)
  verified           Boolean @default(false)
  active             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships ClubMembership[]
  activities  Activity[]
  stats       ClubStats[]
  leaderboard LeaderboardEntry[]
  snapshots   WeeklySnapshot[]

  @@map("clubs")
}

// ─────────────────────────────────────────────
// MEMBRESÍAS — historial completo + regla de 6 meses
// ─────────────────────────────────────────────

model ClubMembership {
  id     String @id @default(cuid())
  userId String
  clubId String

  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  isActive      Boolean   @default(true)
  lockExpiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, isActive], name: "one_active_membership")
  @@index([clubId])
  @@index([userId])
  @@map("club_memberships")
}

// ─────────────────────────────────────────────
// ACTIVIDADES
// ─────────────────────────────────────────────

model Activity {
  id     String  @id @default(cuid())
  userId String
  clubId String?

  distanceMeters      Int
  durationSeconds     Int
  elevationGainMeters Int?
  elevationLossMeters Int?

  activityDate DateTime
  title        String?
  activityType ActivityType   @default(RUN)
  source       ActivitySource @default(MANUAL)
  externalId   String?

  avgPaceSecPerKm Int?
  avgHeartRate    Int?
  maxHeartRate    Int?
  avgCadence      Int?
  calories        Int?

  startLat Float?
  startLng Float?

  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  club   Club?           @relation(fields: [clubId], references: [id])
  record PersonalRecord?

  @@unique([userId, source, externalId])
  @@index([userId, activityDate])
  @@index([clubId, activityDate])
  @@map("activities")
}

// ─────────────────────────────────────────────
// PERSONAL RECORDS
// ─────────────────────────────────────────────

model PersonalRecord {
  id         String     @id @default(cuid())
  userId     String
  activityId String?    @unique

  distance        PRDistance
  durationSeconds Int
  achievedAt      DateTime
  source          PRSource @default(AUTO)

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id])

  @@unique([userId, distance])
  @@index([userId])
  @@map("personal_records")
}

// ─────────────────────────────────────────────
// CLUB STATS — motor de leaderboards
// ─────────────────────────────────────────────

model ClubStats {
  id          String     @id @default(cuid())
  clubId      String
  periodType  PeriodType
  periodStart DateTime
  periodEnd   DateTime

  totalDistanceMeters  Int @default(0)
  totalActivities      Int @default(0)
  totalDurationSeconds Int @default(0)
  activeMembers        Int @default(0)

  avgPaceSecPerKm  Int?
  bestPaceSecPerKm Int?

  totalElevationMeters Int @default(0)

  races5k           Int @default(0)
  races10k          Int @default(0)
  racesHalfMarathon Int @default(0)
  racesMarathon     Int @default(0)
  racesUltra        Int @default(0)

  avgActivitiesPerMember Float @default(0)
  weeksWithActivity      Int   @default(0)

  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, periodType, periodStart])
  @@index([clubId, periodType])
  @@map("club_stats")
}

// ─────────────────────────────────────────────
// LEADERBOARD ENTRIES
// ─────────────────────────────────────────────

model LeaderboardEntry {
  id          String              @id @default(cuid())
  clubId      String
  periodType  PeriodType
  periodStart DateTime
  category    LeaderboardCategory

  rank         Int
  previousRank Int?

  totalDistanceMeters  Int?
  avgPaceSecPerKm      Int?
  totalElevationMeters Int?
  racesMarathon        Int?
  weeksWithActivity    Int?
  distancePerMember    Float?

  calculatedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, periodType, periodStart, category])
  @@index([periodType, periodStart, category, rank])
  @@map("leaderboard_entries")
}

// ─────────────────────────────────────────────
// WEEKLY SNAPSHOTS
// ─────────────────────────────────────────────

model WeeklySnapshot {
  id     String  @id @default(cuid())
  userId String
  clubId String?

  weekStart DateTime

  totalDistanceMeters  Int @default(0)
  totalActivities      Int @default(0)
  totalDurationSeconds Int @default(0)

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club? @relation(fields: [clubId], references: [id])

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@map("weekly_snapshots")
}

// ─────────────────────────────────────────────
// DEVICE CONNECTIONS — una tabla por proveedor
// Cada wearable entrega credenciales y metadata distintos.
// Un usuario solo puede tener UNA conexión activa a la vez
// (enforced por User.connectedProvider + unique userId aquí).
// ─────────────────────────────────────────────

// Garmin — OAuth2 PKCE
// El userId de Garmin NO viene en la respuesta del token;
// se obtiene con una llamada separada a GET /wellness-api/rest/user/id
// después de intercambiar el código de autorización.
model DeviceConnectionGarmin {
  id     String @id @default(cuid())
  userId String @unique

  garminUserId          String   @unique // viene de GET /wellness-api/rest/user/id
  accessToken           String   @db.Text
  refreshToken          String   @db.Text
  tokenExpiresAt         DateTime // expires_in: 86400s (24h) desde la respuesta del token
  refreshTokenExpiresAt DateTime // refresh_token vence en ~90 días

  scope String? // PARTNER_WRITE PARTNER_READ CONNECT_READ CONNECT_WRITE

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  isActive    Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_connections_garmin")
}

// Polar — OAuth2 estándar
// El access_token de Polar NO expira a menos que se revoque.
// Requiere un paso extra: registrar al usuario con POST /v3/users
// usando un member_id propio ANTES de poder leer sus datos.
model DeviceConnectionPolar {
  id     String @id @default(cuid())
  userId String @unique

  polarUserId String @unique // x_user_id, viene en la respuesta del token
  memberId    String @unique // nuestro identificador, enviado en el registro
  accessToken String @db.Text // no expira salvo revocación

  registrationStatus PolarRegistrationStatus @default(PENDING)

  connectedAt  DateTime  @default(now())
  registeredAt DateTime? // cuándo se completó POST /v3/users
  lastSyncAt   DateTime?
  isActive     Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_connections_polar")
}

// Strava — OAuth2 estándar
model DeviceConnectionStrava {
  id     String @id @default(cuid())
  userId String @unique

  stravaAthleteId String   @unique
  accessToken     String   @db.Text
  refreshToken    String   @db.Text
  tokenExpiresAt  DateTime

  scope String? // read,activity:read_all,etc.

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  isActive    Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_connections_strava")
}
