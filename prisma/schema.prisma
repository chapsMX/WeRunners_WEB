// Prisma 7 schema — connection URL is passed via prisma.config.ts
// See: https://pris.ly/d/prisma7-client-config

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  referralCode String   @unique
  referredBy   String?
  createdAt    DateTime @default(now())
}

model AmbassadorApplication {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  country    String
  instagram  String?
  twitter    String?
  tiktok     String?
  motivation String   @db.Text
  status     String   @default("pending") // pending | shortlisted | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
