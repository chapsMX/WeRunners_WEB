// Prisma 7 schema — connection URL is passed via prisma.config.ts
// DATABASE_URL        → pooled connection (Neon / Vercel integration)
// DATABASE_URL_UNPOOLED → direct connection used for migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model AmbassadorApplication {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  country    String
  instagram  String?
  twitter    String?
  tiktok     String?
  motivation String   @db.Text
  status     String   @default("pending") // pending | shortlisted | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
