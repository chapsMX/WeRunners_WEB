# ============================================================
# W3Runn3rs — Environment Variables Example
# Copy to .env.local and fill in values
# ============================================================

# Recommended for most uses
DATABASE_URL=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST/neondb?channel_binding=require&sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST_UNPOOLED/neondb?sslmode=require

# Parameters for constructing your own connection string
PGHOST=REDACTED_HOST
PGHOST_UNPOOLED=REDACTED_HOST_UNPOOLED
PGUSER=neondb_owner
PGDATABASE=neondb
PGPASSWORD=REDACTED_PASSWORD

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST/neondb?channel_binding=require&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST_UNPOOLED/neondb?channel_binding=require&sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_HOST=REDACTED_HOST
POSTGRES_PASSWORD=REDACTED_PASSWORD
POSTGRES_DATABASE=neondb
POSTGRES_URL_NO_SSL=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST/neondb
POSTGRES_PRISMA_URL=postgresql://neondb_owner:REDACTED_PASSWORD@REDACTED_HOST/neondb?channel_binding=require&connect_timeout=15&sslmode=require
